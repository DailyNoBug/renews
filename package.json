{
  "name": "renews-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "cli": "tsx apps/cli/src/main.ts",
    "service": "tsx apps/service/src/server.ts",
    "gateway:smoke": "tsx scripts/smoke-model-gateway.ts",
    "package:cli": "./package-cli.sh",
    "config:validate": "tsx apps/cli/src/main.ts config validate",
    "index:rebuild": "tsx apps/cli/src/main.ts index rebuild"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "pino": "^9.4.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5",
    "vscode": "^1.1.37"
  }
}
